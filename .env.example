# Browser-safe Supabase project values (public by design)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Browser-safe API origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI authentication configuration (no Supabase service-role key required)
HIBI_SUPABASE_URL=https://PROJECT_REF.supabase.co
HIBI_SUPABASE_JWT_AUDIENCE=authenticated
HIBI_CORS_ORIGINS=http://localhost:3000
# Direct private-schema connection. hibi_runtime_user LOGIN inherits only the
# hibi_runtime NOLOGIN privilege role. Provision its password out-of-band.
HIBI_DATABASE_URL=postgresql+asyncpg://hibi_runtime_user:REPLACE_ME@localhost:54322/postgres
